{
  "expo": {
    "name": "Elevation Survey",
    "slug": "elevation-survey",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.brycaqss.elevationsurvey"
    },
    "android": {
      "package": "com.brycaqss.elevationsurvey",
      "adaptiveIcon": {
        "backgroundColor": "#0a1628"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "HIGH_SAMPLING_RATE_SENSORS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Elevation Survey to use your location for GPS altitude reference."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e3aaf273-331c-42cf-b91c-c1839d0323fe"
      }
    }
  }
}
